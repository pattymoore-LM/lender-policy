{
  "schemaVersion": 3,
  "lastUpdated": "2026-06-29",
  "_comment": "LM Clayfield doc-type taxonomy. Naming convention dictated by Patrick (initial 2026-05-11, bank-statement spec finalised 2026-05-20). All bank-statement filename dates are AU format DD.MM.YY (dots, matches Patrick's historical Drive convention e.g. '20.01.26'). Slashes are forbidden in filenames. Year is never first. Bank/lender tokens use the short code (e.g. 'CBA') not the canonical name (e.g. 'CommBank').",
  "_naming_tokens": {
    "{firstName}": "First given name only",
    "{lender}": "Canonical lender name (normalised via lender-normalization.json) — used in non-statement templates",
    "{lenderShort}": "Short lender code (e.g. 'CBA', 'ANZ', 'NAB') — used in all liability statement templates",
    "{bank}": "Canonical bank name (same as {lender}) — used in non-statement templates",
    "{bankShort}": "Short bank code (e.g. 'CBA', 'ANZ', 'NAB') — used in all asset statement templates",
    "{year}": "4-digit year (FY-end year for tax docs)",
    "{employer}": "Employer name",
    "{quarter}": "BAS quarter as Q1/Q2/Q3/Q4",
    "{companyName}": "Company or trust legal name",
    "{streetName}": "Property street name only (just the street, e.g. 'Mulherin Street')",
    "{address}": "Full property address",
    "{accountType}": "ONE of two values for consumer asset accounts (Patrick spec 2026-05-20): 'Salary Credit' if regular salary deposits visible, 'Savings' otherwise. Bank product names (Smart Access / NetBank Saver / Everyday / Offset Savings) are explicitly ignored — collapse to the semantic label. Not used for liabilities (sub-type encodes Credit Card / Home Loan) or business accounts (template hardcodes 'Business Account').",
    "{last4}": "Last 4 digits of account number",
    "{facilityType}": "Credit Card / Personal Loan / Home Loan etc.",
    "{provider}": "BNPL or novated lease provider name",
    "{security}": "Property identifier for settlement docs",
    "{periodEndShort}": "DD.MM short date for payslips (e.g. '31.03')",
    "{endDate}": "DD.MM.YY end-of-period date for bank/loan statements (dots, never slashes or dashes)",
    "{name}": "Person name"
  },
