    "refinancing":                        {"bank_account_transactions": 60, "bank_account_formal_statement": 60},
    "security_guarantors":                {"bank_account_transactions": 60, "bank_account_formal_statement": 60, "home_loan_transactions": 60, "home_loan_formal_statement": 60}
  }
