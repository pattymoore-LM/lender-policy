{
  "_comment": "Currency rules for the Linda Agent. Derived from 'LM Checklist (Minimum Requirements) v4, 4 Oct 2024' and doc-renamer/src/data/lm-checklist.json. The agent uses this to stamp each found document with the right max_age_days + date_label BEFORE writing the findings JSON. build_review.py then does the deterministic age maths (run_date - doc_date <= max_age_days). The key nuance: a bank/transaction statement is <90 days when it is the PAYG salary-credit evidence, but <60 days when it is used for living expenses, other income, or liabilities. So resolve base currency from doc_currency, then apply category_overrides for the category the document is being counted under.",
  "schemaVersion": 1,
  "freshness_backstop_days": 183,
  "_backstop_note": "6-month (183-day) freshness backstop, set by Patrick 22/06/2026: any document dated older than this is out of date unless a tighter window above already governs it. Does NOT apply to ID (expiry) or NOA (financial_year), and never loosens a tighter window. build_review.py enforces it.",
  "doc_currency": {
    "payslip":                       {"max_age_days": 60,  "date_label": "period_end",    "rule_text": "Most recent <60 days"},
    "bank_account_transactions":     {"max_age_days": 90,  "date_label": "statement_end", "rule_text": "1 month, <90 days (salary credit)"},
    "bank_account_formal_statement": {"max_age_days": 90,  "date_label": "statement_end", "rule_text": "1 month, <90 days (salary credit)"},
    "business_account_transactions": {"max_age_days": 90,  "date_label": "statement_end", "rule_text": "<90 days"},
    "business_account_formal_statement": {"max_age_days": 90, "date_label": "statement_end", "rule_text": "<90 days"},
    "credit_card_statement":         {"max_age_days": 60,  "date_label": "statement_end", "rule_text": "<60 days"},
    "credit_card_transactions":      {"max_age_days": 60,  "date_label": "statement_end", "rule_text": "<60 days"},
    "home_loan_formal_statement":    {"max_age_days": 60,  "date_label": "statement_end", "rule_text": "<60 days"},
    "home_loan_transactions":        {"max_age_days": 60,  "date_label": "statement_end", "rule_text": "<60 days"},
    "personal_loan_statement":       {"max_age_days": 60,  "date_label": "statement_end", "rule_text": "<60 days"},
    "car_loan_statement":            {"max_age_days": 60,  "date_label": "statement_end", "rule_text": "<60 days"},
    "equifax_credit_report":         {"max_age_days": 45,  "date_label": "issue",         "rule_text": "CCR latest conduct <45 days"},
    "centrelink_statement":          {"max_age_days": 60,  "date_label": "issue",         "rule_text": "<60 days"},
    "child_support_statement":       {"max_age_days": 60,  "date_label": "issue",         "rule_text": "<60 days"},
    "dividend_statement":            {"max_age_days": 60,  "date_label": "issue",         "rule_text": "<60 days"},
    "rental_income_statement":       {"max_age_days": 60,  "date_label": "issue",         "rule_text": "Recent rental statement / <60 days bank evidence"},
    "bnpl_statement":                {"max_age_days": 60,  "date_label": "issue",         "rule_text": "Current balance"},
    "bas_statement":                 {"max_age_days": null, "date_label": "period_end",   "rule_text": "6 or 12 months per alt-doc / full-doc"},
    "passport":                      {"max_age_days": null, "date_label": "expiry",       "rule_text": "Not expired"},
    "drivers_licence":               {"max_age_days": null, "date_label": "expiry",       "rule_text": "Not expired"},
    "medicare_card":                 {"max_age_days": null, "date_label": "expiry",       "rule_text": "Not expired"},
    "notice_of_assessment":          {"max_age_days": null, "date_label": "financial_year", "rule_text": "Latest financial year"},
    "tax_return":                    {"max_age_days": null, "date_label": "financial_year", "rule_text": "Latest financial year"},
    "personal_tax_return":           {"max_age_days": null, "date_label": "financial_year", "rule_text": "Latest financial year"},
    "company_trust_tax_return":      {"max_age_days": null, "date_label": "financial_year", "rule_text": "Latest financial year"},
    "company_trust_financials":      {"max_age_days": null, "date_label": "financial_year", "rule_text": "Latest financial year"},
    "ato_portal":                    {"max_age_days": null, "date_label": "issue",         "rule_text": "Current extract"},
    "contract_of_sale":              {"max_age_days": null, "date_label": "executed",      "rule_text": "Fully executed"},
    "asic_abn_search":               {"max_age_days": null, "date_label": "none",          "rule_text": "ABN registered 6+ months (alt-doc)"},
    "privacy_consent":               {"max_age_days": null, "date_label": "none",          "rule_text": "Executed"},
    "game_plan":                     {"max_age_days": null, "date_label": "none",          "rule_text": "Executed"},
    "client_quote":                  {"max_age_days": null, "date_label": "none",          "rule_text": "Executed if fee charged"},
    "broker_notes":                  {"max_age_days": null, "date_label": "none",          "rule_text": "On file"},
    "serviceability_calculator":     {"max_age_days": null, "date_label": "none",          "rule_text": "On file"},
